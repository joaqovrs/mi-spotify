# Copiar a infra/.env en el servidor y completar. El .env NO se versiona.
#
#   cp infra/.env.ejemplo infra/.env && nano infra/.env
#
# Usuario administrador de Navidrome. El servicio de registro entra con el
# para poder crear usuarios; nunca sale del servidor.
ND_ADMIN_USER=
ND_ADMIN_PASS=

# Codigo que hay que escribir en la app para poder crear una cuenta.
# Generar uno al azar con:  openssl rand -hex 8
CODIGO_INVITACION=
